.venv/
.tools/
__pycache__/
*.pyc
.pytest_cache/
.env
# Large / regenerated by `make weights`; verified by SHA256 in manifests/model.json
manifests/weights/*.pth
# Per-run evidence is kept locally; the evidence index records hashes.
artifacts/*
!artifacts/.gitkeep
monitoring/targets/*.yml
!monitoring/targets/.gitkeep
# CPU reference logits are specific to the environment that generated them: regenerate with
# `make reference` inside the pinned image on the evaluation host, then commit deliberately.
manifests/reference/*
!manifests/reference/.gitkeep
deploy/image-digests.env.local

# Slurm job output
slurm-*.out
slurm-*.err
raw-artifacts.tgz
