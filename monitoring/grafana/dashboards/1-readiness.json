{
  "uid": "lab-readiness",
  "title": "Lab 1 - System readiness and inventory",
  "tags": [
    "gpu-workload-lab"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "utc",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Inference readiness",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Whether /readyz would return 200: config, weights, requested backend and smoke inference passed.\n\nUnit: boolean (1 = ready)\nSource: inference service /metrics (inference_ready)\nInterval: 5 s scrape / 5 s rule interval\nMissing data: No data means the service is not being scraped: shown as 'UNKNOWN', not as ready.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "inference_ready",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN",
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "READY",
                  "color": "green"
                },
                "0": {
                  "text": "NOT READY",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Scrape targets",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Monitoring health: can Prometheus reach each exporter.\n\nUnit: boolean (1 = scrape ok)\nSource: Prometheus up\nInterval: 5 s scrape / 5 s rule interval\nMissing data: A target that is not configured for the active profile does not appear.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up",
          "legendFormat": "{{job}}",
          "refId": "A",
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN",
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cold-start time to ready",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Process start to first ready (AC07 cold target 120 s).\n\nUnit: seconds\nSource: inference service (inference_startup_seconds)\nInterval: 5 s scrape / 5 s rule interval\nMissing data: Empty until the service has become ready once.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "inference_startup_seconds",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "not ready yet",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Workload restarts (persistent)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Workload restarts (persistent)\n\nUnit: count\nSource: host controller (lab_workload_restarts_total)\nInterval: 5 s scrape / 5 s rule interval\nMissing data: Empty if the controller is not running. Counter survives workload and controller restarts.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "lab_workload_restarts_total",
          "legendFormat": "{{workload}}",
          "refId": "A",
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "controller not reporting",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Loaded model and backend",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Loaded model version, backend and precision.\n\nUnit: n/a\nSource: inference service (inference_model_info labels)\nInterval: 5 s scrape / 5 s rule interval\nMissing data: Empty until a model is loaded.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "inference_model_info",
          "legendFormat": "",
          "refId": "A",
          "interval": "5s",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "unavailable",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "GPU identity (from DCGM labels)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "GPU model and UUID as reported by DCGM (compare with preflight.json inventory).\n\nUnit: n/a\nSource: dcgm-exporter (labels modelName, UUID, gpu)\nInterval: 5 s scrape / 5 s rule interval\nMissing data: If the field is unsupported on this GPU or dcgm-exporter is down the panel is empty ('unavailable'). It is never plotted as 0. See artifacts/*/capabilities.json and the TelemetryUnavailable alert.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "DCGM_FI_DEV_GPU_UTIL",
          "legendFormat": "",
          "refId": "A",
          "interval": "5s",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "unavailable",
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Host disk free (/)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Host disk free (/)\n\nUnit: bytes\nSource: node-exporter\nInterval: 5 s scrape / 5 s rule interval\nMissing data: Empty if node-exporter is down (TelemetryUnavailable).",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "unavailable",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Controller heartbeat age",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Controller heartbeat age\n\nUnit: seconds\nSource: host controller\nInterval: 5 s scrape / 5 s rule interval\nMissing data: Empty if the controller is not scraped.",
      "gridPos": {
        "x": 6,
        "y": 10,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - lab_controller_heartbeat_timestamp_seconds",
          "legendFormat": "controller",
          "refId": "A",
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "controller not reporting",
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background"
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Recovery state",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Recovery state\n\nUnit: state label\nSource: host controller\nInterval: 5 s scrape / 5 s rule interval\nMissing data: Only workloads whose container exists are listed.",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "lab_controller_state == 1",
          "legendFormat": "{{workload}}: {{state}}",
          "refId": "A",
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "controller not reporting",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background"
      }
    },
    {
      "id": 10,
      "type": "text",
      "title": "Inventory and capability evidence",
      "gridPos": {
        "x": 18,
        "y": 10,
        "w": 6,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Static inventory is recorded by `make preflight` in `artifacts/preflight/<run>/preflight.json` (hardware, driver, toolkit, image digest, model/input hashes) and `capabilities.json` (supported / unsupported / unavailable GPU telemetry fields). This dashboard shows the live view; the files are the evidence."
      },
      "description": "Inventory and capability evidence\n\nUnit: n/a\nSource: static text\nInterval: static\nMissing data: n/a (does not query data)"
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}
