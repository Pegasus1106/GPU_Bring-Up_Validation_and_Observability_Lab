# Image pins. Tags are the starting point; `make pin-images` resolves each tag to an
# immutable digest and writes deploy/image-digests.env, which `make up-*` then prefers.
# Choose a driver / CUDA / container-toolkit / DCGM combination supported by the vendor
# documentation for your GPU, then record the tested set in manifests/environment.json.
#
# CUDA runtime in the base image must be supported by the host driver
# (nvidia-smi shows the maximum supported CUDA version).
BASE_IMAGE=pytorch/pytorch:2.7.0-cuda12.8-cudnn9-runtime
PROMETHEUS_IMAGE=prom/prometheus:v3.16.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1
GRAFANA_IMAGE=grafana/grafana:11.6.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1
# DCGM Exporter tag is "<exporter version>-<DCGM version>-<os>": use a supported pair.
DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.2.3-4.1.1-ubuntu22.04
